{
  "name": "durood-quest",
  "version": "0.1.0",
  "description": "Durood Quest - recite durood Shareef every day with your caravan",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "FLAG_NEW_HIGH=1000000000 node --test --no-warnings test/*.test.js",
    "e2e": "node scripts/e2e.mjs",
    "fuzz": "node --no-warnings scripts/fuzz.mjs",
    "audit": "node server/audit.js",
    "icons": "node scripts/make-icons.js",
    "stress": "node --no-warnings scripts/stress.mjs",
    "test:dates": "sh scripts/test-dates.sh",
    "guide": "node scripts/guide-build.mjs",
    "guide:pdf": "node scripts/guide-build.mjs --pdf",
    "guide:shots": "node --no-warnings scripts/guide-shots.mjs"
  }
}
